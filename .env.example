# Cloud Benchmarker configuration template.
# Copy this file to `.env` in the repository root and adjust the values.
# Changes require a server restart (values are read at import time).

# SQLAlchemy database URL. A relative SQLite path is anchored to the
# repository root, so the same database file is used no matter which
# directory you launch the server from.
SQLALCHEMY_ENGINE_CONNECTION_STRING=sqlite:///cloud_benchmarker.sqlite

# Minutes between benchmarking playbook runs (staleness threshold is half
# this interval). Must be >= 1; values below 1 are clamped.
PLAYBOOK_RUN_INTERVAL_IN_MINUTES=360

# Ansible inventory path; relative paths are resolved against the
# repository root.
ANSIBLE_INVENTORY_FILE_PATH=my_ansible_inventory_file.ini

# Maximum number of recent rows plotted per table in the charts dashboard.
MAX_DATA_POINTS_FOR_CHART=1000
